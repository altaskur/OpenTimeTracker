{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "../../dist/electron",
    "rootDir": "../src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": "../..",
    "paths": {
      "@prisma/generated/*": ["prisma/generated/client/*"]
    }
  },
  "include": ["../src/**/*"],
  "exclude": ["node_modules", "dist", "../src/preload/**/*"]
}
