{
  "extends": "./build/tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "esModuleInterop": true,
    "composite": true,
    "declaration": true,
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "isolatedModules": true
  },
  "include": ["src/**/*.spec.ts", "src/**/*.ts"]
}
