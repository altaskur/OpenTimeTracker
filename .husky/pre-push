# Load environment variables from .env
if [ -f .env ]; then
  export $(cat .env | grep -v '^#' | xargs)
fi

echo "🔍 Running SonarQube analysis..."

# Use cmd to run npm on Windows (Git Bash compatibility)
if command -v npm.cmd &> /dev/null; then
  npm.cmd run sonar:check
else
  npm run sonar:check
fi

if [ $? -ne 0 ]; then
  echo "❌ Push rejected: SonarQube analysis failed"
  exit 1
fi

echo "✅ SonarQube Quality Gate passed - proceeding with push"
