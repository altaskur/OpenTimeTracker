#!/bin/sh

echo "🔍 Running tests before push..."

# Use npx to ensure npm commands work across different environments
export PATH="$PATH:$(dirname $(which node))"

# Run Angular tests
npm run test:coverage
ANGULAR_EXIT=$?

if [ $ANGULAR_EXIT -ne 0 ]; then
  echo "❌ Push rejected: Angular tests failed"
  exit 1
fi

# Run Electron tests
npm run test:electron:coverage
ELECTRON_EXIT=$?

if [ $ELECTRON_EXIT -ne 0 ]; then
  echo "❌ Push rejected: Electron tests failed"
  exit 1
fi

echo "✅ All tests passed - proceeding with push"
