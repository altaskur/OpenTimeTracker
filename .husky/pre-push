#!/bin/sh

# Get the current branch
current_branch=$(git symbolic-ref --short HEAD)

# Get the remote branch being pushed to (may fail if no upstream is set)
remote_ref=$(git rev-parse --abbrev-ref --symbolic-full-name @{push} 2>/dev/null || echo "")
remote_branch=$(echo "$remote_ref" | sed 's/.*\///')

# If no remote branch detected, use the current branch name as target
if [ -z "$remote_branch" ]; then
  remote_branch="$current_branch"
fi

# Block direct pushes to main or develop
if [ "$remote_branch" = "main" ] || [ "$current_branch" = "main" ]; then
  echo "🚫 Direct push to 'main' is not allowed!"
  echo "📝 Please create a Pull Request from 'develop' instead."
  echo ""
  exit 1
fi

if [ "$remote_branch" = "develop" ] || [ "$current_branch" = "develop" ]; then
  echo "🚫 Direct push to 'develop' is not allowed!"
  echo "📝 Please create a Pull Request from your feature branch instead."
  echo ""
  echo "   git checkout -b feat/your-feature"
  echo "   git push origin feat/your-feature"
  echo "   Then create a PR on GitHub"
  echo ""
  exit 1
fi

# Check if pushing to a branch that will target develop (feature branches)
# Run SonarQube check for branches that will merge into develop
if echo "$current_branch" | grep -qE "^(feat|fix|chore|refactor|docs|style|test)/"; then
  echo "🔍 Running SonarQube analysis before push to feature branch..."
  echo "   This is required for PRs targeting 'develop'"
  echo ""

  # Check if SonarQube is running
  if ! curl -s http://localhost:9000/api/system/status > /dev/null 2>&1; then
    echo "⚠️  SonarQube is not running!"
    echo "📝 Start it with: docker-compose up -d"
    echo "   Wait ~2 minutes for it to initialize, then try again."
    echo ""
    exit 1
  fi

  # Check if SONAR_TOKEN is configured
  if [ ! -f ".env" ] || ! grep -q "SONAR_TOKEN" .env; then
    echo "⚠️  SONAR_TOKEN not found in .env file!"
    echo "📝 Create a token in SonarQube (http://localhost:9000)"
    echo "   My Account → Security → Generate Tokens"
    echo "   Then add to .env: SONAR_TOKEN=your_token"
    echo ""
    exit 1
  fi

  # Run sonar:check
  if ! npm run sonar:check; then
    echo ""
    echo "❌ SonarQube analysis failed!"
    echo "📝 Fix the issues and try again."
    echo ""
    exit 1
  fi

  echo ""
  echo "✅ SonarQube analysis passed!"
fi

echo "✅ Push allowed to $current_branch"
